# JANRAKSHA AI - Environment Configuration

# Backend Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database Configuration
# Default Local Dev Fallback (Zero configuration SQLite):
DATABASE_URL="file:./dev.db"

# PostgreSQL Configuration (When PostgreSQL is available in production/staging):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/janraksha_ai?schema=public"

# Authentication / Security
JWT_SECRET="janraksha_dev_secret_key_change_in_production_min_32_chars"
JWT_EXPIRES_IN="7d"

# AI Intelligence Engine Parameters
AI_DUPLICATE_SIMILARITY_THRESHOLD=0.65
AI_CRITICAL_ESCALATION_KEYWORDS="spark,fire,blast,electrocution,hospital,collapse,short circuit,हादसा,आग,करंट"
